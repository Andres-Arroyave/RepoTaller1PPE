generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model PaqueteTuristico {
  id               String   @id @default(uuid())
  nombre           String
  imagen           String
  descripcion      String
  destino          String
  precio           Float
  duracionDias     Int
  cuposDisponibles Int
  estado           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  nombre    String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}